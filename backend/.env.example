APP_NAME=Cottonil AI Assistant API
APP_ENV=development
API_PREFIX=/api

# مسارات ملفات البيانات — عدّلها حسب مكان ملفاتك الفعلي
SALES_DATA_PATH=./data/fact_sales.csv
RETURNS_DATA_PATH=./data/fact_returns.csv

# أسماء الأعمدة — لازم تتطابق مع ملفات البيانات الفعلية
SALES_DATE_COL=sale_date
SALES_AMOUNT_COL=net_sales
SALES_QTY_COL=sold_quantity
SALES_BRANCH_COL=branch_name
SALES_PRODUCT_COL=product_name
SALES_GOVERNORATE_COL=governorate
SALES_CHANNEL_COL=channel

RETURNS_DATE_COL=return_date
RETURNS_QTY_COL=quantity_returned
RETURNS_AMOUNT_COL=refund_amount_EGP
RETURNS_BRANCH_COL=branch_name
RETURNS_PRODUCT_COL=product_name
RETURNS_GOVERNORATE_COL=governorate
RETURNS_CHANNEL_COL=channel